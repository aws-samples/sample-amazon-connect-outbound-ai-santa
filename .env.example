# Copy to .env (git-ignored) and fill in. Read by `npm run sandbox`.
AWS_REGION=eu-central-1

# Required
CONNECT_INSTANCE_ID=
SANTA_SENDER_EMAIL=santa@example.com
# Set to false if the sender is already a verified identity in SES
CREATE_SENDER_IDENTITY=true
# true = Cognito's invitations and password resets go through your SES account (default sender: 50 a day
# per account). Turn it on only once SES has production access. SES_IDENTITY = the verified domain or
# address that covers SANTA_SENDER_EMAIL (empty = the address itself).
COGNITO_EMAIL_VIA_SES=false
SES_IDENTITY=
# Comma-separated emails or @domains allowed to create accounts. Empty = nobody.
SIGNUP_ALLOWLIST=

# Fill after creating the flow and AI agent in Connect (see connect/README.md), then redeploy
CONNECT_CONTACT_FLOW_ID=
CONNECT_SOURCE_PHONE_NUMBER=
QCONNECT_ASSISTANT_ID=

# Optional: outbound campaign with answering machine detection
CONNECT_CAMPAIGN_ID=

# Optional overrides
ALLOWED_PHONE_PREFIXES=+34
# false = parents may skip the SMS code and type the number. Anyone signed in can then make Santa call any allowed number.
REQUIRE_PHONE_VERIFICATION=true
# AWS End User Messaging Notify for the phone verification SMS. Create both with `npm run notify:setup`
# (docs/adr/0006-phone-verification-notify.md) and paste the two lines it prints.
NOTIFY_CONFIGURATION_ARN=
NOTIFY_CODE_CONFIGURATION_ID=
BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
CALL_WINDOW_START=09:00
CALL_WINDOW_END=22:00
MAX_CALL_ATTEMPTS=3
RETRY_DELAY_MINUTES=15
# Abuse and cost limits, enforced in the backend
MAX_CALLS_PER_DAY=50
MAX_SMS_CODES_PER_HOUR=5
# AWS WAF on the AppSync API (managed rules + per-IP limit per 5 minutes). false = no WAF (it has a monthly cost)
ENABLE_WAF=true
WAF_RATE_LIMIT=300
# Web app URL, shown in the invitation email when an admin creates a user (optional)
APP_URL=
# true = create the secret and KMS key Connect needs to speak with an ElevenLabs voice (connect/README.md, step 4b).
# ElevenLabs then receives everything Santa says, including the child's name and wishes.
ELEVENLABS_TTS=false
# Store for the "Ver ideas en Amazon" link under each wish in the parents' email. "off" = no links.
GIFT_LINKS_DOMAIN=amazon.es
# Optional Amazon Associates tracking ID for those links. Empty = plain links. Check the programme's and your employer's rules first.
AMAZON_ASSOCIATE_TAG=
