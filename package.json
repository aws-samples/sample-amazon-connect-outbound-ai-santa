{
  "name": "santa-call-center",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p amplify/tsconfig.json",
    "sandbox": "set -a && . ./.env && set +a && ampx sandbox",
    "elevenlabs:secret": "bash scripts/elevenlabs-secret.sh",
    "notify:setup": "node scripts/notify-setup.mjs",
    "sandbox:delete": "set -a && . ./.env && set +a && ampx sandbox delete",
    "nag": "sh scripts/nag.sh",
    "setup": "node scripts/setup.mjs",
    "designer:setup": "node scripts/designer-setup.mjs",
    "connect:flow": "node scripts/connect-flow.mjs",
    "web:deploy": "node scripts/web-deploy.mjs"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "6.15.7",
    "@aws-sdk/client-bedrock-runtime": "3.1168.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1168.0",
    "@aws-sdk/client-connect": "3.1168.0",
    "@aws-sdk/client-dynamodb": "3.1168.0",
    "@aws-sdk/client-endusermessaging": "3.1171.0",
    "@aws-sdk/client-lambda": "3.1168.0",
    "@aws-sdk/client-scheduler": "3.1168.0",
    "@aws-sdk/client-sesv2": "3.1168.0",
    "@aws-sdk/lib-dynamodb": "3.1168.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/mountains-of-christmas": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "aws-amplify": "6.22.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "1.25.1",
    "@aws-amplify/backend-cli": "1.10.0",
    "@aws-sdk/client-amplify": "3.1172.0",
    "@aws-sdk/client-cloudformation": "3.1172.0",
    "@aws-sdk/client-pinpoint-sms-voice-v2": "3.1172.0",
    "@aws-sdk/client-sts": "3.1172.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "amazon-connect-acxd-sdk": "0.5.0",
    "aws-cdk": "2.1148.1",
    "aws-cdk-lib": "2.277.0",
    "aws-sdk-client-mock": "4.1.0",
    "cdk-nag": "2.38.2",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "oxlint": "1.93.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "description": "Santa calls your child through Amazon Connect and an Agentic CX designer agent, and emails the parents the wishlist",
  "license": "MIT-0",
  "overrides": {
    "handlebars": "4.7.10",
    "lodash": "4.18.1",
    "@ardatan/relay-compiler": {
      "immutable": "3.8.4"
    }
  }
}
